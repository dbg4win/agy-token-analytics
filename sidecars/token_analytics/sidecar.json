{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Token Analytics",
  "description": "Real-time telemetry for context window utilization, session token consumption, cost & cache savings, and agent-wide analytics.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Token Analytics",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Token Analytics"
      },
      {
        "path": "/full",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_SIDEBAR",
        "title": "Token Analytics"
      }
    ]
  }
}
